{
  "name": "chessboard-vanilla-v2",
  "version": "2.0.0",
  "description": "Professional full-stack chess puzzle platform with TypeScript, PostgreSQL, and React - 32,000+ puzzles for skill development",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build:all": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend-v2 && npm install && npm run build",
    "build:v2": "cd frontend-v2 && npm run build > frontend_build.log 2>&1",
    "build:backend": "cd backend-v2 && npm install && npm run build",
    "start": "cd backend-v2 && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend-v2 && npm run dev",
    "dev:frontend": "cd frontend-v2 && npm run dev",
    "dev:electron": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron-start\"",
    "dev:electron-start": "NODE_ENV=development electron .",
    "build:electron": "npm run build:frontend && electron-builder",
    "start:electron": "electron .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:api": "node tools/test-orchestrator-file-logging.js",
    "test:frontend-v2": "node tools/test-frontend-v2-connectivity.js > frontend_v2_test_output.log 2>&1",
    "test:backend": "cd backend-v2 && npm test",
    "test:frontend": "cd frontend-v2 && npm test",
    "backend:generator": "cd tools/backend-tools/backend-generator-v2 && python3 main.py --force > ../../../backend_generator_output.log 2>&1",
    "frontend:generator": "cd tools/frontend-tools/frontend-generator-v2 && python3 main.py > ../../../frontend_generator_output.log 2>&1",
    "id:setter": "./tools/frontend-tools/id-setter/run.sh",
    "payload:generator": "cd tools/backend-tools/payload-generator && python3 payload_generator.py",
    "missing:columns": "python3 tools/backend-tools/missing-columns/missing-columns.py --backend-path backend-v2",
    "postinstall": "cd backend-v2 && npm install && cd ../frontend-v2 && npm install"
  },
  "keywords": [
    "react",
    "javascript",
    "electron"
  ],
  "author": "Claude Code Assistant",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.chessboard-vanilla-v2.app",
    "productName": "Master Chess Training",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns"
    },
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  }
}
