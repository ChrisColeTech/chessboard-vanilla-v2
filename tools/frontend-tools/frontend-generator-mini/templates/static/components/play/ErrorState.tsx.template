// ErrorState.tsx - Error state display following SRP
// Single Responsibility: Display error states with recovery options

import React from 'react';

interface ErrorStateProps {
  /** Error message to display */
  message: string;
  /** Optional additional error details */
  details?: string;
  /** Handler for retry action */
  onRetry?: () => void;
  /** Handler for dismiss action */
  onDismiss?: () => void;
  /** Custom retry button text */
  retryText?: string;
  /** Whether to show as critical error */
  critical?: boolean;
}

const ErrorState: React.FC<ErrorStateProps> = ({
  message,
  details,
  onRetry,
  onDismiss,
  retryText = 'Try Again',
  critical = false
}) => {
  const bgColor = 'bg-card';
  const borderColor = critical ? 'border-destructive' : 'border-border';
  const textColor = critical ? 'text-destructive' : 'text-foreground';
  const iconColor = critical ? 'text-destructive' : 'text-accent';
  const buttonColor = critical ? 'bg-destructive hover:bg-destructive/90 text-destructive-foreground' : 'bg-accent hover:bg-accent/90 text-accent-foreground';

  return (
    <div className="flex items-center justify-center min-h-[50vh] p-4">
      <div className={`${bgColor} ${borderColor} border rounded-lg p-4 sm:p-6 max-w-md w-full`}>
        <div className="flex flex-col sm:flex-row items-center sm:items-start gap-3">
          {/* Error icon */}
          <div className={`${iconColor} flex-shrink-0`}>
            {critical ? (
              <svg className="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 18.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
            ) : (
              <svg className="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
          </div>
          
          {/* Error content */}
          <div className="flex-1 text-center sm:text-left">
            <h3 className={`${textColor} font-medium text-sm sm:text-base mb-2`}>
              {critical ? 'Critical Error' : 'Something went wrong'}
            </h3>
            
            <p className={`${textColor} text-sm mb-2`}>
              {message}
            </p>
            
            {details && (
              <p className={`text-xs sm:text-sm text-muted-foreground mb-4`}>
                {details}
              </p>
            )}
            
            {/* Action buttons */}
            <div className="flex flex-col sm:flex-row gap-2 sm:gap-3 justify-center sm:justify-start">
              {onRetry && (
                <button
                  onClick={onRetry}
                  className={`${buttonColor} text-white px-4 py-2 rounded text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-opacity-50 w-full sm:w-auto`}
                >
                  {retryText}
                </button>
              )}
              
              {onDismiss && (
                <button
                  onClick={onDismiss}
                  className="text-muted-foreground hover:text-foreground px-4 py-2 text-sm font-medium transition-colors focus:outline-none w-full sm:w-auto"
                >
                  Dismiss
                </button>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default ErrorState;
