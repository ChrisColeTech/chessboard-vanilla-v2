# Railway Deployment Environment Variables Template
# Copy to Railway Dashboard -> Project Settings -> Variables

# Database Configuration (Required)
DATABASE_URL=postgresql://postgres.username:password@host:5432/database

# Application Configuration
NODE_ENV=production
PORT=3001

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-here

# CORS Configuration (Optional - defaults to Railway domain)
CORS_ORIGINS=https://your-app.railway.app

# Feature Flags (Optional)
ENABLE_TEST_DB_ENDPOINT=false
ENABLE_DETAILED_ERRORS=false