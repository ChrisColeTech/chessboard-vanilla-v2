{
  "name": "chessboard-vanilla-backend-v2",
  "version": "1.0.0",
  "description": "Chessboard Vanilla V2 Backend - PostgreSQL + Generated Architecture",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon --exec ts-node src/app.ts",
    "dev:watch": "nodemon src/app.ts",
    "build": "tsc -b",
    "build:clean": "rm -rf dist && tsc",
    "build:watch": "tsc --watch",
    "start:dev": "ts-node src/app.ts",
    "start:prod": "npm run build && npm start",
    "lint": "echo \"No linter configured\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "express": "^4.18.x",
    "cors": "^2.8.x",
    "helmet": "^7.0.x",
    "dotenv": "^16.3.x",
    "pg": "^8.11.x",
    "jsonwebtoken": "^9.0.x",
    "bcrypt": "^5.1.x",
    "uuid": "^9.0.x",
    "chess.js": "^1.0.x",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.x",
    "@types/cors": "^2.8.x",
    "@types/pg": "^8.10.x",
    "@types/jsonwebtoken": "^9.0.x",
    "@types/bcrypt": "^5.0.x",
    "@types/uuid": "^9.0.x",
    "@types/node": "^20.0.x",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.0.x",
    "ts-node": "^10.9.x",
    "nodemon": "^3.0.x"
  },
  "keywords": [
    "chess",
    "training",
    "backend",
    "postgresql",
    "api"
  ],
  "author": "",
  "license": "MIT"
}
